# ==============================================================================
# FluxTube Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your Google Cloud API credentials.
# In development / offline test mode, FluxTube runs with built-in fixtures/mocks.
# ==============================================================================

# Google Cloud OAuth 2.0 Credentials
# Recommended for TV/Device code flow (google.com/device):
#   Credentials -> Create Credentials -> OAuth client ID -> TVs and Limited Input devices (requires Client ID + Secret)
# Alternative Browser PKCE flow:
#   Credentials -> Create Credentials -> OAuth client ID -> Desktop app
# You can also enter these directly inside the app (Account -> API & OAuth Credentials).
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# YouTube Data API v3 Key
# Create in Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Application Configuration
FLUXTUBE_ENV=development
FLUXTUBE_LOG_LEVEL=info
FLUXTUBE_OFFLINE_MOCK=false
FLUXTUBE_HTTP_TIMEOUT_SECS=15
FLUXTUBE_STORAGE_PATH=./data/fluxtube.db
